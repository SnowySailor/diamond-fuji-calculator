# Dev: Google Maps JavaScript API key, restricted by HTTP referrer to http://127.0.0.1:4778/*
# Enable "Maps JavaScript API" and (optionally) "Elevation API" on it.
VITE_GOOGLE_MAPS_API_KEY=

# Deploy: put a second key, restricted to the deployed URL, in .env.production.local
# (git-ignored). `npm run deploy` refuses to run without it.
