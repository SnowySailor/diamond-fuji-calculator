// Static site on Workers static assets: no Worker script, Cloudflare serves dist/ directly.
// Deploy with `docker compose run --rm deploy` (see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diamond-fuji",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist" },
  "workers_dev": true,
  "preview_urls": false
}
